---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in site.html_pages %}
{%- if p.sitemap == true %}
  <url>
    <loc>{{ p.url | replace: 'index.html', '' | prepend: site.baseurl | prepend: site.url }}</loc>
    <lastmod>{{ site.time | date: "%Y-%m-%d" }}</lastmod>
    <priority>{% if p.url == "/" %}1.0{% else %}0.8{% endif %}</priority>
  </url>
{%- endif %}
{%- endfor %}
</urlset>
